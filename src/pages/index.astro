---
import App from '../components/App';
import '../styles/global.css';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>500 Scorer</title>
    <meta name="description" content="Scorekeeper for the card game 500 — 4 players, 2 teams." />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="theme-color" content="#0a3322" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  </head>
  <body>
    <!-- client:only: the game is restored from localStorage, so render on the client only. -->
    <App client:only="preact" />
    <noscript><p style="padding:1rem">500 Scorer needs JavaScript.</p></noscript>
  </body>
</html>
